{
  "name": "web-daw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:arch": "node scripts/validate-architecture.mjs",
    "lint:boundaries": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "clean": "powershell -Command \"Get-ChildItem -Path src,tests -Recurse -Include *.js,*.js.map | Remove-Item -Force -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force node_modules\\.vite,node_modules\\.tmp,dist -ErrorAction SilentlyContinue; Write-Host '✅ Limpio' -ForegroundColor Green\"",
    "clean:all": "powershell -Command \"npm run clean; Remove-Item -Recurse -Force src-tauri\\target -ErrorAction SilentlyContinue; Write-Host '✅ Limpio (incluyendo target de Rust)' -ForegroundColor Green\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2.11.1",
    "immer": "^11.1.11",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
